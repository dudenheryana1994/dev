<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_user_tree" model="ir.ui.view">
        <field name="name">user.tree</field>
        <field name="model">modulakuntingcustom.user</field>
        <field name="arch" type="xml">
            <tree string="User">
                <field name="name"/>
                <field name="username"/>
                <field name="email"/>
                <field name="access_rights"/>
            </tree>
        </field>
    </record>

    <record id="view_user_form" model="ir.ui.view">
        <field name="name">user.form</field>
        <field name="model">modulakuntingcustom.user</field>
        <field name="arch" type="xml">
            <form string="User">
                <header>
                    <button name="fetch_ldap_users" type="object" string="Sync LDAP Users" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="username"/>
                        <field name="email"/>
                        <field name="password" password="True"/>
                        <field name="card"/>
                        <field name="access_rights"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_user" model="ir.actions.act_window">
        <field name="name">Users</field>
        <field name="res_model">modulakuntingcustom.user</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_modulakuntingcustom_root" name="User Management"/>
    <menuitem id="menu_modulakuntingcustom_user" name="Users" parent="menu_modulakuntingcustom_root" action="action_user"/>
</odoo>
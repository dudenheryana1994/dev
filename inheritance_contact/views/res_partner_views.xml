<odoo>
  <record id="view_partner_form_inherit_extra_fields" model="ir.ui.view">
    <field name="name">res.partner.form.inherit.extra.fields</field>
    <field name="model">res.partner</field>
    <field name="inherit_id" ref="base.view_partner_form"/>
    <field name="arch" type="xml">

      <!-- Ganti label "e.g. Lumber Inc" menjadi "Nama Pelanggan" -->
      <xpath expr="//field[@name='name']" position="replace">
          <field name="name" string="Nama Pelanggan" placeholder="Nama Pelanggan"/>
      </xpath>

      <!-- Tambahkan field tambahan -->
      <xpath expr="//sheet/group" position="before">
        <group string="Informasi">

          <!-- Baris 1: Jenis Jual, Kunci Jual, Jenis Ijin -->
          <group>
            <field name="jenis_jual"/>
            <field name="kunci_jual"/>
            <field name="jenis_izin"/>
          </group>

          <!-- Baris 2: Kode, Nama Klasifikasi Pelanggan, Wilayah -->
          <group>
            <field name="klasifikasi_pelanggan"/>
            <field name="wilayah"/>
          </group>

          <!-- Baris 3: Pemilik, No Izin Sarana, Masa Berlaku -->
          <group>
            <field name="pemilik"/>
            <field name="no_ijin"/>
            <field name="masa_berlaku"/>
          </group>

          <group>
            <field name="penanggung_jawab"/>
            <field name="no_ijin_apt"/>
            <field name="masa_berlaku_apt"/>
          </group>
        </group>
      </xpath>

      <!-- Ganti label Address menjadi Alamat Pengirim -->
      <xpath expr="//span[@name='address_name']/b" position="replace">
        <b invisible="not is_company">Alamat Pengirim</b>
      </xpath>

      <!-- Ganti label Street menjadi Jalan -->
      <xpath expr="//field[@name='street']" position="replace">
        <field name="street" string="Jalan" placeholder="Jalan" class="o_address_street" readonly="type == 'contact' and parent_id"/>
      </xpath>

      <!-- Ganti label Street 2 menjadi Jalan 2 -->
      <xpath expr="//field[@name='street2']" position="replace">
        <field name="street2" string="Jalan 2" placeholder="Jalan 2" class="o_address_street" readonly="type == 'contact' and parent_id"/>
      </xpath>

      <!-- Ganti label City menjadi Kota -->
      <xpath expr="//field[@name='city']" position="replace">
        <field name="city" string="Kota" placeholder="Kota" class="o_address_city" readonly="type == 'contact' and parent_id"/>
      </xpath>

      <!-- Ganti label State menjadi Provinsi -->
      <xpath expr="//field[@name='state_id']" position="replace">
        <field name="state_id" string="Provinsi" class="o_address_state" placeholder="Provinsi" options="{'no_open': True, 'no_quick_create': True}" readonly="type == 'contact' and parent_id" context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}"/>
      </xpath>

      <!-- Ganti label ZIP menjadi Kode Pos -->
      <xpath expr="//field[@name='zip']" position="replace">
        <field name="zip" string="Kode Pos" placeholder="Kode Pos" class="o_address_zip" readonly="type == 'contact' and parent_id"/>
      </xpath>

      <!-- Ganti label Country menjadi Negara -->
      <xpath expr="//div[@name='partner_address_country']/field[@name='country_id']" position="replace">
        <field name="country_id" string="Negara" placeholder="Negara" class="o_address_country" options="{'no_open': True, 'no_create': True}" readonly="type == 'contact' and parent_id"/>
      </xpath>

      <!-- Ganti label Phone menjadi Handphone -->
      <xpath expr="//field[@name='phone']" position="attributes">
        <attribute name="string">Handphone</attribute>
      </xpath>

      <!-- Ganti label Mobile menjadi Telepon -->
      <xpath expr="//field[@name='mobile']" position="attributes">
        <attribute name="string">Telepon</attribute>
      </xpath>

      <!-- Ganti field website dengan fax -->
      <xpath expr="//field[@name='website']" position="replace">
        <field name="fax" string="Fax"/>
      </xpath>

      <!-- Sembunyikan Tags -->
      <xpath expr="//field[@name='category_id']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>

      <!-- npwp 16 digit -->
      <xpath expr="//field[@name='vat']" position="attributes">
          <attribute name="string">NPWP</attribute>
          <attribute name="placeholder">Masukkan 16 digit</attribute>
      </xpath>

      <!-- Tambahkan Nama Wajib Pajak setelah field VAT -->
      <xpath expr="//field[@name='vat']" position="after">
          <field name="nama_wp" string="Nama Wajib Pajak"/>
      </xpath>

    </field>
  </record>
</odoo>

<odoo>
    <record id="view_koneksi_pemasok_form" model="ir.ui.view">
        <field name="name">koneksi.pemasok.form</field>
        <field name="model">koneksi.pemasok</field>
        <field name="arch" type="xml">
            <form string="Koneksi Pemasok">
                <sheet>
                    <group>
                        <field name="prinsipal_id"/>
                        <field name="pemasok_id" options="{'no_create': False}" />
                        <field name="kode"/>
                        <field name="alamat"/>
                        <field name="wiraniaga"/>
                        <field name="no_hp"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_koneksi_pemasok_tree" model="ir.ui.view">
        <field name="name">koneksi.pemasok.tree</field>
        <field name="model">koneksi.pemasok</field>
        <field name="arch" type="xml">
            <tree string="Koneksi Pemasok">
                <field name="prinsipal_id" readonly="1"/>
                <field name="pemasok_id"/>
                <field name="kode"/>
                <field name="alamat"/>
                <field name="wiraniaga"/>
                <field name="no_hp"/>
            </tree>
        </field>
    </record>

    <!-- ACTION Window -->
    <record id="action_koneksi_pemasok" model="ir.actions.act_window">
        <field name="name">Koneksi Pemasok</field>
        <field name="res_model">koneksi.pemasok</field>
        <field name="view_mode">tree,form</field>
        <field name="views">
            [(ref('view_koneksi_pemasok_tree'), 'tree'),
             (ref('view_koneksi_pemasok_form'), 'form')]
        </field>
        <field name="context">{'default_prinsipal_id': active_id}</field>
        <field name="domain">[('prinsipal_id', '=', active_id)]</field>
        <field name="target">new</field>
    </record>
</odoo>

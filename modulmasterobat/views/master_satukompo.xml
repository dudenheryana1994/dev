<odoo>
    <!-- Tree View -->
    <record id="view_satuan_komposisi_tree" model="ir.ui.view">
        <field name="name">satuan.komposisi.tree</field>
        <field name="model">master.satukompo</field>
        <field name="arch" type="xml">
            <tree>
                <field name="kode"/>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_satuan_komposisi_form" model="ir.ui.view">
        <field name="name">satuan.komposisi.form</field>
        <field name="model">master.satukompo</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="kode" readonly="1"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_satuan_komposisi" model="ir.actions.act_window">
        <field name="name">Daftar Satuan Komposisi</field>
        <field name="res_model">master.satukompo</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>
                Input data satuan komposisi Anda di sini.
            </p>
        </field>
    </record>
</odoo>

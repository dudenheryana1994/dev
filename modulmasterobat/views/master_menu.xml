    <!-- Submenu yang mengarah ke action "Pemasok" -->
    <menuitem id="menu_master_pemasok" name="Daftar Pemasok" parent="menu_master_golongan" action="action_master_pemasok" sequence="9"/>

    <!-- Submenu yang mengarah ke action "Regional" -->
    <menuitem id="menu_master_regional" name="Daftar Regional" parent="menu_master_golongan" action="action_master_regional" sequence="10"/>

    <!-- Submenu yang mengarah ke action "Product" -->
    <menuitem id="menu_master_product" name="Master Poduct" parent="menu_master_golongan" action="action_master_product" sequence="11"/>

